APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# On shared hosting (e.g. Hostinger) MySQL has a low connection limit.
# Keep sessions/cache OFF the database (use "file") so every web request
# does not open a DB connection just to read the session — this is what
# causes intermittent "SQLSTATE[08004] [1040] Too many connections" 500s.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="withabdullah88@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Shopify Integration (public app — OAuth authorization code grant)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders
SHOPIFY_REDIRECT_URI=
SHOPIFY_APP_STORE_URL=

# iMile courier — fallback used only if not configured in Apps → iMile Settings
IMILE_CUSTOMER_ID=
IMILE_API_KEY=
IMILE_BASE_URL=https://openapi.imile.com
IMILE_TIME_ZONE=+3

# LogesTechs (Navix). Leave blank to use the shared Navix test account baked
# into config/services.php — convenient for development, but note LogesTechs
# has NO sandbox: company 722 is live and every shipment dispatches a real
# driver. Set these (or configure Apps → LogesTechs Settings) in production.
LOGESTECHS_COMPANY_ID=
LOGESTECHS_EMAIL=
LOGESTECHS_PASSWORD=
# Must match the username/password set in LogesTechs' "Edit customer webhook"
# panel — they are echoed back on every push and verified on our side.
LOGESTECHS_WEBHOOK_USERNAME=
LOGESTECHS_WEBHOOK_PASSWORD=
LOGESTECHS_BASE_URL=https://apisv2.logestechs.com/api
# Shown as "Package Source" in the LogesTechs portal. Their UI renders this as
# a translation key, so a value they haven't registered on their side displays
# raw (e.g. "INTEGRATION_SOURCE.ksadrop_portal").
LOGESTECHS_INTEGRATION_SOURCE=ksadrop_portal

# Meta WhatsApp Cloud API — order confirmation flow. Fallback used only if not
# configured in Apps → WhatsApp Settings (DB settings take precedence).
# IDs and App Secret: Meta App Dashboard → WhatsApp → API Setup / Settings → Basic.
# Use a System User PERMANENT access token in production; dashboard tokens expire in 24h.
# WHATSAPP_WEBHOOK_VERIFY_TOKEN is a string you invent and paste into the Meta
# dashboard webhook config so the two sides match.
# The two template names must be APPROVED in WhatsApp Manager — there is no
# plain-text fallback, Meta rejects un-templated business-initiated messages.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_DISPLAY_PHONE_NUMBER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_TEMPLATE_ORDER_PENDING=
WHATSAPP_TEMPLATE_FOLLOWUP=
