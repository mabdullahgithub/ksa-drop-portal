# Custom Caddyfile for the VPS (Coolify builds with Railpack, which uses this file
# from the project root in place of its own default). It is Railpack's default
# Caddyfile with only two deliberate differences, marked "CHANGED" below. Shared
# hosting never reads this file.
{
	admin off
	persist_config off
	auto_https off

	{$CADDY_GLOBAL_OPTIONS}

	# CHANGED: the default logs at DEBUG, which wrote ~30 lines/minute of internal
	# request chatter and buried real problems in Coolify's log view. WARN keeps
	# every warning and error.
	log {
		format json
		output stderr
		level WARN
	}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

:{$PORT:80} {
	root * /app/public

	encode zstd br gzip

	# CHANGED: Vite names every file under /build/assets with a content hash, so a
	# given URL never changes. Let browsers keep them for a year without
	# re-checking on every visit (faster repeat loads, better LCP). Pages, API
	# responses and everything else keep their normal no-cache behaviour.
	@hashed_assets path /build/assets/*
	header @hashed_assets Cache-Control "public, max-age=31536000, immutable"

	file_server {
		hide .git
		hide .env*
	}

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	php_server
}
